{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git branch*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git remote*)",
      "Bash(git fetch*)",
      "Bash(git checkout*)",
      "Bash(git push*)",
      "Bash(git add*)",
      "Bash(git config*)",
      "Bash(git rebase*)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(gh *)",
      "Bash(glab *)",
      "Bash(docker compose*)",
      "Bash(terraform plan*)",
      "Bash(aws --profile *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(npm *)",
      "Bash(bun *)",
      "Bash(curl *)",
      "Bash(chmod *)",
      "Bash(shellcheck *)",
      "Bash(markitdown *)",
      "Bash(./scripts/ci/validate.sh)",
      "Bash(./scripts/ci/drift-check.sh)",
      "Read(*)",
      "Edit(.claude/plans/*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.syndicate/hooks/pre-push-test-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.syndicate/hooks/pre-stage-secrets-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.syndicate/hooks/pre-dispatch-godspeed-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.syndicate/hooks/post-tool-test-sentinel.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.syndicate/hooks/godspeed.sh"
          },
          {
            "type": "command",
            "command": "~/.syndicate/hooks/precheck-asking-detector.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.syndicate/hooks/session-start-syndicate.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.syndicate/hooks/post-compact-reread.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.syndicate/hooks/session-end-ledger.sh"
          }
        ]
      }
    ]
  }
}
