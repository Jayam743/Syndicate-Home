{
  "__README__": "SANITIZED REFERENCE — NOT a drop-in. This is a snapshot of BJ's ~/.claude/settings.json captured to document which HOOKS BJ's workflow registers (and in what lifecycle slots). It was sanitized before vendoring: the AWS profile value was redacted, and username-bearing absolute paths were rewritten to ~/. The `env` block is BJ's Bedrock configuration and does NOT apply to a home Pro subscription (subscriptions resolve the opus/sonnet/haiku aliases directly — do not set model env vars). See MANIFEST.md.",
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-east-1",
    "AWS_PROFILE": "<REDACTED>",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "Sonnet 4.5 (1M)",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-4-8[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "Opus 4.6 (1M)",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "us.anthropic.claude-opus-4-8[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Opus 4.8 (1M)",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Claude Opus 4.8 (1M) — swap-in for main loop via /model when heavy reasoning is wanted"
  },
  "permissions": {
    "allow": [
      "Bash(aws:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(docker compose:*)",
      "Bash(gh:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git config:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git status:*)",
      "Bash(glab:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(pip3:*)",
      "Bash(pip:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(shellcheck:*)",
      "Bash(terraform:*)",
      "Edit(.claude/plans/*)",
      "Read",
      "WebFetch",
      "Write(.claude/plans/*)"
    ]
  },
  "model": "us.anthropic.claude-opus-4-8[1m]",
  "availableModels": [
    "opus",
    "sonnet",
    "haiku"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/workflow/pre-push-test-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/workflow/pre-stage-secrets-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/workflow/post-tool-test-sentinel.sh"
          }
        ]
      },
      {
        "matcher": "Skill|ToolSearch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/workflow/post-tool-context-tracker.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/wtf-server/hooks/wtf-post-tool-use.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/nerf/session-start-compact.sh"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/workflow/reseed-revive.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/flightdeck-session-emit.sh open"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/nerf/pre-compact.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/workflow/post-compact-reread.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/precheck-asking-detector.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/stop-action-bias-detector.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<wavemachine-stall-guard inline shell — omitted from reference; see BJ's live settings for the verbatim guard>"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/flightdeck-session-emit.sh idle"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/flightdeck-session-emit.sh close"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
