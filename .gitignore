# ALL Loki-derived content stays LOCAL — the repo tracks NONE of it. Raw monthly logs
# (~/.syndicate/loki/*.md) contain session-specific (possibly sensitive) observations,
# and the regenerated CHANGELOG is a view over them, so it can re-leak the same content
# — both are local-only. scripts/loki-changelog.sh writes loki/CHANGELOG.md as a
# local-only regenerable view (gitignored below). Only loki/logs/.gitkeep stays tracked,
# so the dir survives a clone.
loki/logs/*.md
loki/CHANGELOG.md

# OS junk
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# WTF flight-recorder session data (local, transient)
.wtf/

# SQLite recall index (built under ~/.syndicate, but guard against any stray copy
# landing in the repo tree — never commit a .db, esp. from the WSL /mnt/c mount)
*.db
*.db-wal
*.db-shm
kb/recall-index.db

# Python bytecode (repo now has python scripts)
__pycache__/
*.pyc
